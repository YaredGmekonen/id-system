# ==============================================================================
# SiliconLabs Enterprise ID Card Platform — Environment Configuration
# ==============================================================================

# --- Application Environment ---
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# --- Frontend Configuration (Vite) ---
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_ENABLE_OFFLINE_FALLBACK=true
# Google OAuth 2.0 Web Client ID from Google Cloud Console
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com


# --- Database Configuration (PostgreSQL / Supabase) ---
# For local PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/id_platform_db
# For Supabase / Remote PostgreSQL Pooler:
# DATABASE_URL=postgresql://postgres.your-project:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

DB_POOL_MIN=2
DB_POOL_MAX=20
DB_TIMEOUT_MS=10000

# --- Object Storage Configuration ---
# Storage Driver: 'local' | 'supabase' | 's3'
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_MAX_FILE_SIZE_MB=15

# (For Supabase Storage - Phase 3 preparation)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=id-platform-assets

# --- Security & Rate Limiting ---
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# --- Worker & Batch Generation ---
WORKER_CONCURRENCY=4
GENERATION_CHUNK_SIZE=250
JOB_POLL_INTERVAL_MS=2000

# --- Structured Logging ---
LOG_LEVEL=info
